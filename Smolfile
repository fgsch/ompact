  '''bash -ceu '
apt-get update
apt-get install -y --no-install-recommends util-linux passwd
rm -rf /var/lib/apt/lists/*

install -d -m 0755 /usr/local/libexec/omp
mv /usr/local/bin/omp /usr/local/libexec/omp/omp

getent group omp >/dev/null 2>&1 || groupadd --system omp
if ! id -u omp >/dev/null 2>&1; then
  useradd --system --gid omp --home-dir /home/omp \
    --shell /usr/sbin/nologin --no-create-home omp
fi
usermod --gid omp --home /home/omp --shell /usr/sbin/nologin omp
install -d -m 0755 -o omp -g omp /home/omp
cat >/home/omp/.gitconfig <<\EOF
[safe]
directory = /workspace
EOF
chown omp:omp /home/omp/.gitconfig
chmod 0644 /home/omp/.gitconfig

cat > /usr/local/bin/omp <<\EOF
#!/usr/bin/env bash
set -Eeuo pipefail

export HOME=/home/omp
export USER=omp
export LOGNAME=omp

state_owner_uid=
state_owner_gid=
state_candidates=()
if [[ -n ${PI_CODING_AGENT_DIR:-} ]]; then
  state_candidates+=( "$PI_CODING_AGENT_DIR" )
fi
state_candidates+=( /home/omp/.omp/agent /home/omp/.omp )
for state_path in "${state_candidates[@]}"; do
  [[ -e "$state_path" ]] || continue
  if ! state_owner_uid="$(/usr/bin/stat -c "%u" -- "$state_path")"; then
    printf "unable to inspect omp state path %s\n" "$state_path" >&2
    exit 1
  fi
  if ! state_owner_gid="$(/usr/bin/stat -c "%g" -- "$state_path")"; then
    printf "unable to inspect omp state path %s\n" "$state_path" >&2
    exit 1
  fi
  break
done

if [[ -n "$state_owner_uid" ]]; then
  if [[ ! "$state_owner_uid" =~ ^[0-9]+$ ]]; then
    printf "omp state path owner is not numeric: %s\n" "$state_owner_uid" >&2
    exit 1
  fi
  if [[ ! "$state_owner_gid" =~ ^[0-9]+$ ]]; then
    printf "omp state group is not numeric: %s\n" "$state_owner_gid" >&2
    exit 1
  fi
  if [[ "$state_owner_uid" == 0 || "$state_owner_gid" == 0 ]]; then
    printf "omp state path %s is owned by root; mount a writable directory owned by a non-root host user\n" "$state_path" >&2
    exit 1
  fi

  omp_uid="$(/usr/bin/id -u omp)"
  omp_gid="$(/usr/bin/id -g omp)"
  if [[ "$state_owner_uid" != "$omp_uid" ]]; then
    if /usr/bin/getent passwd "$state_owner_uid" >/dev/null 2>&1; then
      printf "omp state owner uid %s is already assigned to another guest account; use a different non-root host owner\n" "$state_owner_uid" >&2
      exit 1
    fi
  fi
  if [[ "$state_owner_gid" != "$omp_gid" ]] &&
    ! /usr/bin/getent group "$state_owner_gid" >/dev/null 2>&1; then
    /usr/sbin/groupmod --gid "$state_owner_gid" omp
  fi
  if [[ "$state_owner_uid" != "$omp_uid" || "$state_owner_gid" != "$omp_gid" ]]; then
    /usr/sbin/usermod --uid "$state_owner_uid" --gid "$state_owner_gid" omp
    /usr/bin/chown "$state_owner_uid:$state_owner_gid" /home/omp
    for tool_path in /home/omp/.cargo /home/omp/go /home/omp/.cache \
      /home/omp/.config/go/telemetry; do
      [[ -e "$tool_path" ]] || continue
      /usr/bin/chown -R "$state_owner_uid:$state_owner_gid" -- "$tool_path"
    done
  fi
fi

exec /usr/sbin/runuser --user omp --preserve-environment -- \
  /usr/bin/setpriv --no-new-privs --inh-caps=-all --ambient-caps=-all \
  /usr/local/libexec/omp/omp "$@"
EOF
chmod 0755 /usr/local/bin/omp
' ''',
