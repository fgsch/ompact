#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/ompact-build-test.XXXXXX")"
FAKE_SMOLVM="$WORKDIR/smolvm"
SMOLVM_LOG="$WORKDIR/smolvm.log"
SMOLVM_SMOLFILE_LOG="$WORKDIR/pack.smolfile"
STATUS_COUNT="$WORKDIR/status-count"
BUILD_OUTPUT="$WORKDIR/build.out"

cleanup() {
  rm -rf -- "$WORKDIR"
}
trap cleanup EXIT

fail() {
  printf 'assertion failed: %s\n' "$*" >&2
  exit 1
}
assert_file_contains() {
  local file="$1"
  local needle="$2"
  local contents
  contents="$(<"$file")"
  [[ "$contents" == *"$needle"* ]] ||
    fail "$file is missing: $needle"
}

assert_file_not_contains() {
  local file="$1"
  local needle="$2"
  local contents
  contents="$(<"$file")"
  [[ "$contents" != *"$needle"* ]] ||
    fail "$file unexpectedly contains: $needle"
}

# Approved dependency pins are guarded independently of installer behavior.
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'image = "debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2"'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'http://snapshot.debian.org/archive/debian/20261113T000000Z trixie main'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'http://snapshot.debian.org/archive/debian/20261113T000000Z trixie-updates main'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'http://snapshot.debian.org/archive/debian-security/20261113T000000Z trixie-security main'

assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'cmd = ["--"]'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'workdir = "/workspace"'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'cat >/home/omp/.gitconfig <<\EOF'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  '[safe]'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'directory = /workspace'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "github_meta=\"\$(mktemp)\""
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'https://api.github.com/meta'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  '.ssh_keys | type == \"array\" and length > 0 and all'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "-o \"\$github_meta\""
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'github.com \" + .'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "chmod 0644 \"\$github_known_hosts\""
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "mv -f -- \"\$github_known_hosts\" /etc/ssh/ssh_known_hosts"

assert_file_not_contains "$PROJECT_ROOT/Smolfile" \
  'git config --global'

assert_file_not_contains "$PROJECT_ROOT/build.sh" \
  'SMOLVM_BIN'
assert_file_not_contains "$PROJECT_ROOT/build.sh" \
  "VM_NAME=\"\${VM_NAME:-"
assert_file_not_contains "$PROJECT_ROOT/build.sh" \
  "SMOLFILE=\"\${SMOLFILE:-"
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'omp_version=v18.19.0'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'omp_sha256=61826bf89c2c0512417fee05fa2f486e60ee11b23ea95a17257a6c49edb6b8d5'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'omp_sha256=b44fda2ae5c9cce2bbe124d1672cba532a136d9e1eef68599b16efcd3bc5c626'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'jj_version=v0.47.1\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "jj_archive=jj-\${jj_version}-aarch64-unknown-linux-musl.tar.gz"$'\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "jj_archive=jj-\${jj_version}-x86_64-unknown-linux-musl.tar.gz"$'\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'jj_sha256=0f300e1576de8dabe0a9dedf0b87ae44f8accea5cf54d9a342a51061c1fb1bcd\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'jj_sha256=d4b657f622ee50929c8916466dfa3d6a6c17a0a32b50e7b2c793707ec9ebcad7\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'fd_version=v10.5.2'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'fd_sha256=63ea52cb31586e6d98efa2f06d73d542f16c7d0c4af0f07b579aaf9714cf907a'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'fd_sha256=7e2d07fa2b8807642aaec67b7e2972a9fbe4db26fcb340a7372392db42b26694'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'rg_version=15.2.0'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'rg_sha256=800b1e7206afe799dfb5a6901f23147cfaabe0e52210538100f61e86e1740915'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'rg_sha256=33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'gh_version=v2.104.0\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'gh_archive=gh_2.104.0_linux_arm64.tar.gz\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'gh_archive=gh_2.104.0_linux_amd64.tar.gz\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'gh_sha256=cb34cefc6f4e77b90731374a2b737516bb8f3033c6ca46aa949e5344f68069e3\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'gh_sha256=98cb101ad87dbbd3f6b2f2bfcbd43197ccd07643140121d8a9cfaa91eadbc24e\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'sd_version=v1.1.0'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "sd-\${sd_version}-aarch64-unknown-linux-musl.tar.gz"
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "sd-\${sd_version}-x86_64-unknown-linux-musl.tar.gz"
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'sd_sha256=ec8c93c0533ff21f4851d11566808d4082544baf063d9b96ea77c27e98b7cd99'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'sd_sha256=02f00f4777d43e8e95b7b8d49e1a0d6e502fed4b8e79c1c8b8063857a30caa2e'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "https://github.com/chmln/sd/releases/download/\$sd_version/\$sd_archive"
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  "install -m 0755 \"\$sd_extract/\${sd_archive%.tar.gz}/sd\" /usr/local/bin/sd"
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'sg_version=0.51.2\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'sg_archive=app-aarch64-unknown-linux-gnu.zip\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'sg_archive=app-x86_64-unknown-linux-gnu.zip\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'sg_sha256=c3ab2bd43959db28621dc1551c13ea5fe5db4c1fc7b18086dade6b65042c78d0\n'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  $'sg_sha256=40604c21c38d4c7581c56bdddeef277c56bf3c0113620aa96e78ae87e82366df\n'
assert_file_not_contains "$PROJECT_ROOT/Smolfile" \
  'fd-find ripgrep'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'build-essential pkg-config libssl-dev jq tar python3 python-is-python3'
assert_file_not_contains "$PROJECT_ROOT/Smolfile" \
  'build-essential pkg-config libssl-dev jq tar python3 python-is-python3 gh'
assert_file_not_contains "$PROJECT_ROOT/env/python.sh" \
  'uv python install'
assert_file_not_contains "$PROJECT_ROOT/env/python.sh" \
  'PYTHON_VERSION='
assert_file_not_contains "$PROJECT_ROOT/Smolfile" \
  'https://omp.sh/install'
assert_file_contains "$PROJECT_ROOT/env/go.sh" \
  $'GO_VERSION=${GO_VERSION:-go1.27.4}\n'
assert_file_contains "$PROJECT_ROOT/env/go.sh" \
  $'GOPLS_VERSION=${GOPLS_VERSION:-0.24.0}\n'
assert_file_contains "$PROJECT_ROOT/env/go.sh" \
  $'GOVULNCHECK_VERSION=${GOVULNCHECK_VERSION:-1.9.0}\n'
assert_file_contains "$PROJECT_ROOT/env/go.sh" \
  $'STATICCHECK_VERSION=${STATICCHECK_VERSION:-0.8.2}\n'
assert_file_contains "$PROJECT_ROOT/env/go.sh" \
  $'GOLANGCI_LINT_VERSION=${GOLANGCI_LINT_VERSION:-2.15.0}\n'
assert_file_contains "$PROJECT_ROOT/env/rust.sh" \
  $'RUST_TOOLCHAIN=${RUST_TOOLCHAIN:-1.100.0}\n'
assert_file_contains "$PROJECT_ROOT/env/rust.sh" \
  $'CARGO_AUDIT_VERSION=${CARGO_AUDIT_VERSION:-0.23.0}\n'
assert_file_contains "$PROJECT_ROOT/env/rust.sh" \
  $'CARGO_DENY_VERSION=${CARGO_DENY_VERSION:-0.20.2}\n'
assert_file_contains "$PROJECT_ROOT/env/rust.sh" \
  $'CARGO_NEXTEST_VERSION=${CARGO_NEXTEST_VERSION:-0.9.151}\n'
assert_file_contains "$PROJECT_ROOT/env/rust.sh" \
  $'CARGO_LLVM_COV_VERSION=${CARGO_LLVM_COV_VERSION:-0.9.1}\n'
assert_file_contains "$PROJECT_ROOT/env/python.sh" \
  $'UV_VERSION=${UV_VERSION:-0.13.8}\n'
assert_file_contains "$PROJECT_ROOT/env/python.sh" \
  $'UV_INSTALLER_SHA256=4d8fa56e00f16b66feecacbd943773c61d61ab768b13856de350d86fd8740e2f\n'

cat >"$FAKE_SMOLVM" <<'FAKE_SMOLVM'
#!/usr/bin/env bash
set -Eeuo pipefail

: "${SMOLVM_LOG:?SMOLVM_LOG is required}"
printf '%q ' "$@" >> "$SMOLVM_LOG"
printf '\n' >> "$SMOLVM_LOG"

if [[ "${1:-}" == --version ]]; then
  printf 'smolvm test-version\n'
  exit 0
fi
if [[ "${SMOLVM_FAIL_ON:-}" == "${1:-}:${2:-}" ]] &&
  [[ -z "${SMOLVM_FAIL_MATCH:-}" ||
    "$*" == *"$SMOLVM_FAIL_MATCH"* ]]; then
  exit "${SMOLVM_FAIL_STATUS:-1}"
fi
if [[ "${SMOLVM_EXISTING:-0}" == 1 &&
  "${1:-}:${2:-}" == machine:create ]]; then
  exit 1
fi

if [[ -n "${SMOLVM_SLEEP:-}" ]]; then
  sleep "$SMOLVM_SLEEP"
fi
case "${1:-}:${2:-}" in
  machine:status)
    exit 0
    ;;
  machine:create|machine:start|machine:exec|machine:stop|machine:update|machine:delete)
    exit 0
    ;;
  pack:create)
    output=''
    smolfile=''
    while (($# > 0)); do
      case "$1" in
      --output)
        (($# >= 2)) || { printf 'missing pack output\n' >&2; exit 1; }
        output="$2"
        shift 2
        ;;
      --smolfile)
        (($# >= 2)) || { printf 'missing pack Smolfile\n' >&2; exit 1; }
        smolfile="$2"
        shift 2
        ;;
      *)
        shift
        ;;
      esac
    done
    [[ -n "$smolfile" ]] || { printf 'missing pack Smolfile\n' >&2; exit 1; }
    cp "$smolfile" "$SMOLVM_SMOLFILE_LOG"
    [[ -n "$output" ]] || { printf 'missing pack output\n' >&2; exit 1; }
    cat > "$output" <<'FAKE_LAUNCHER'
#!/usr/bin/env bash
set -Eeuo pipefail

: "${SMOLVM_LOG:?SMOLVM_LOG is required}"
environment_check=0
if [[ "$#" -eq 4 &&
  "${1:-}" == run &&
  "${2:-}" == -- &&
  "${3:-}" == /usr/local/bin/omp &&
  "${4:-}" == --version ]]; then
  :
elif [[ "$#" -eq 9 &&
  "${1:-}" == run &&
  "${2:-}" == --user &&
  "${3:-}" == omp &&
  "${4:-}" == -v &&
  "${5:-}" == */env:/opt/ompact-env:ro &&
  "${6:-}" == -- &&
  "${7:-}" == /bin/sh &&
  "${9:-}" == check ]]; then
  environment_script="${8}"
  environment_check=1
else
  exit 1
fi
if ((environment_check)); then
  selected_system_install=0
  selected_user_install=0
  selected_check=0
  while IFS= read -r invocation; do
    if [[ "$invocation" == machine\ exec* &&
      "$invocation" == *" -- /bin/sh ${environment_script} install-system " ]]; then
      selected_system_install=1
    fi
    if [[ "$invocation" == machine\ exec* &&
      "$invocation" == *" --user omp -- /bin/sh ${environment_script} install-user " ]]; then
      selected_user_install=1
    fi
    if [[ "$invocation" == machine\ exec* &&
      "$invocation" == *" --user omp -- /bin/sh ${environment_script} check " ]]; then
      selected_check=1
    fi
  done < "$SMOLVM_LOG"
  ((selected_system_install == 1 &&
    selected_user_install == 1 &&
    selected_check == 1)) || exit 1
fi
printf 'environment harness passed\n'
printf '%q ' packaged-launcher "$@" >> "$SMOLVM_LOG"
printf '\n' >> "$SMOLVM_LOG"

exit 0
FAKE_LAUNCHER
    chmod +x "$output"
    exit 0
    ;;
  *)
    printf 'unexpected fake smolvm invocation\n' >&2
    exit 1
    ;;
esac
FAKE_SMOLVM
chmod +x "$FAKE_SMOLVM"
FAKE_BIN="$WORKDIR/bin"
mkdir -p "$FAKE_BIN"
ln "$FAKE_SMOLVM" "$FAKE_BIN/smolvm"

FAKE_HOME="$WORKDIR/home"
mkdir -p "$FAKE_HOME/.smolvm"

export HOME="$FAKE_HOME"
export PATH="$FAKE_BIN:$PATH"
export VM_NAME="$WORKDIR/unexpected-vm"
export SMOLFILE="$WORKDIR/unexpected-smolfile"
export SMOLVM_BIN="$WORKDIR/unexpected-smolvm"
export SMOLVM_LOG
export SMOLVM_SMOLFILE_LOG
export SMOLVM_STATUS_COUNT="$STATUS_COUNT"
export RUST_TOOLCHAIN='1.99.0'
export RUSTUP_HOME='/usr/local/rustup'
export CARGO_HOME='/home/omp/.cargo'
export GO_VERSION='go1.27.2'
export GOBIN='/home/omp/go/bin'
export UV_VERSION='0.12.22'
export UV_CACHE_DIR='/var/cache/uv'
export CARGO_AUDIT_VERSION='0.22.2'
export CARGO_DENY_VERSION='0.20.2'
export CARGO_NEXTEST_VERSION='0.9.146'
export CARGO_LLVM_COV_VERSION='0.9.1'
export GOPLS_VERSION='0.23.0'
export GOVULNCHECK_VERSION='1.8.0'
export STATICCHECK_VERSION='0.8.1'
export GOLANGCI_LINT_VERSION='2.14.0'
export CPUS='8'
export MEMORY='16384'

assert_log_contains() {
  local needle="$1"
  [[ "$log_contents" == *"$needle"* ]] ||
    fail "fake smolvm log is missing: $needle"
}

assert_log_not_contains() {
  local needle="$1"
  [[ "$log_contents" != *"$needle"* ]] ||
    fail "fake smolvm log unexpectedly contains: $needle"
}

assert_log_line_equals() {
  local expected="$1"
  local invocation
  while IFS= read -r invocation; do
    [[ "$invocation" == "$expected" ]] && return 0
  done <<<"$log_contents"
  fail "fake smolvm log is missing exact invocation: $expected"
}

assert_log_order() {
  local before="$1"
  local after="$2"
  local before_line=0
  local after_line=0
  local line_number=0
  local invocation
  while IFS= read -r invocation; do
    line_number=$((line_number + 1))
    if [[ "$invocation" == "$before" && $before_line == 0 ]]; then
      before_line="$line_number"
    fi
    if [[ "$invocation" == "$after" && $after_line == 0 ]]; then
      after_line="$line_number"
    fi
  done <<<"$log_contents"
  ((before_line > 0 && after_line > 0 && before_line < after_line)) ||
    fail "expected invocation order: $before before $after"
}

find_log_line() {
  local prefix="$1"
  local invocation
  while IFS= read -r invocation; do
    if [[ "$invocation" == "$prefix"* ]]; then
      printf '%s\n' "$invocation"
      return 0
    fi
  done <<<"$log_contents"
  return 1
}
assert_output_line_equals() {
  local expected="$1"
  local output_line
  while IFS= read -r output_line; do
    [[ "$output_line" == "$expected" ]] && return 0
  done <"$BUILD_OUTPUT"
  fail "build output is missing exact line: $expected"
}

run_case() {
  local case_name="$1"
  local environments="$2"
  local explicit_empty="${EXPLICIT_EMPTY_ARGUMENT:-0}"
  shift 2
  local expected_environments=("$@")
  local output="$WORKDIR/ompact-$case_name"
  local vm_name
  local create_invocation
  local pack_create_invocation
  local expected_pack_path
  local environment_volume="$PROJECT_ROOT/env:/opt/ompact-env:ro"
  local environment_mount="$PROJECT_ROOT/env:/opt/ompact-env"
  local environment_name
  local machine_exec_system_install
  local machine_exec_user_install
  local machine_exec_check
  local packaged_check
  local build_status
  local expected_count
  local expected_path_entries=()
  local expected_runtime_path

  rm -f -- "$STATUS_COUNT" "$output" "$output.smolmachine"
  : >"$SMOLVM_LOG"
  : >"$SMOLVM_SMOLFILE_LOG"
  export OUTPUT="$output"

  set +e
  if [[ -n "$environments" ]]; then
    "$PROJECT_ROOT/build.sh" "$environments" >"$BUILD_OUTPUT" 2>&1
  elif ((explicit_empty)); then
    "$PROJECT_ROOT/build.sh" '' >"$BUILD_OUTPUT" 2>&1
  else
    "$PROJECT_ROOT/build.sh" >"$BUILD_OUTPUT" 2>&1
  fi
  build_status=$?
  set -e
  if ((build_status != 0)); then
    printf '%s case failed (status %d):\n' "$case_name" "$build_status" >&2
    cat "$BUILD_OUTPUT" >&2
    exit 1
  fi

  [[ -x "$output" ]] || fail "$case_name output is not executable"
  [[ ! -e "$output.smolmachine" && ! -L "$output.smolmachine" ]] ||
    fail "$case_name output has a sidecar"
  [[ ! -e /tmp/ompact.smolmachine &&
    ! -L /tmp/ompact.smolmachine ]] ||
    fail "$case_name left a legacy sidecar"

  log_contents="$(<"$SMOLVM_LOG")"
  create_invocation="$(find_log_line 'machine create ')" ||
    fail "$case_name is missing machine create invocation"
  if [[ "$create_invocation" =~ --name[[:space:]]+(omp-package-builder-[^[:space:]]+) ]]; then
    vm_name="${BASH_REMATCH[1]}"
  else
    fail "$case_name machine create did not use a generated VM name"
  fi
  pack_create_invocation="$(find_log_line 'pack create ')" ||
    fail "$case_name is missing pack create invocation"
  assert_log_contains "machine start --name $vm_name "
  assert_log_contains "machine exec --name $vm_name -- /usr/local/bin/omp --version "
  assert_log_contains "machine stop --name $vm_name "
  assert_log_contains "machine delete --name $vm_name --force "
  assert_log_line_equals 'packaged-launcher run -- /usr/local/bin/omp --version '
  [[ "$create_invocation" == *"--name $vm_name"* ]] ||
    fail "$case_name machine create is missing: --name $vm_name"
  [[ "$create_invocation" == *"--smolfile $PROJECT_ROOT/Smolfile"* ]] ||
    fail "$case_name machine create is missing --smolfile"
  [[ "$create_invocation" == *'--net'* ]] ||
    fail "$case_name machine create is missing build network override: --net"
  [[ "$pack_create_invocation" == *"--from-vm $vm_name"* ]] ||
    fail "$case_name pack create is missing --from-vm $vm_name"
  [[ "$pack_create_invocation" == *'--smolfile '* ]] ||
    fail "$case_name pack create is missing --smolfile"
  [[ "$pack_create_invocation" == *'--single-file'* ]] ||
    fail "$case_name pack create is missing --single-file"
  [[ "$pack_create_invocation" == *"--output $output"* ]] ||
    fail "$case_name pack create is missing --output"
  if [[ ${CPUS+x} ]]; then
    [[ "$create_invocation" == *'--cpus 8'* ]] ||
      fail "$case_name machine create is missing: --cpus 8"
    [[ "$pack_create_invocation" == *'--cpus 8'* ]] ||
      fail "$case_name pack create is missing: --cpus 8"
  else
    assert_log_not_contains '--cpus'
  fi
  if [[ ${MEMORY+x} ]]; then
    [[ "$create_invocation" == *'--mem 16384'* ]] ||
      fail "$case_name machine create is missing: --mem 16384"
    [[ "$pack_create_invocation" == *'--mem 16384'* ]] ||
      fail "$case_name pack create is missing: --mem 16384"
  else
    assert_log_not_contains '--mem'
  fi
  expected_count="${#expected_environments[@]}"
  if ((expected_count > 0)); then
    assert_output_line_equals "environments selected: ${expected_environments[*]}"
    assert_log_order \
      "machine update --name $vm_name --remove-volume $environment_mount " \
      "$pack_create_invocation"
    [[ "$create_invocation" == *"--volume $environment_volume"* ]] ||
      fail "$case_name machine create is missing environment volume"
    expected_path_entries=()
    for environment_name in "${expected_environments[@]}"; do
      case "$environment_name" in
      rust) expected_path_entries+=("$CARGO_HOME/bin") ;;
      go) expected_path_entries+=("$GOBIN") ;;
      esac
    done
    if ((${#expected_path_entries[@]})); then
      expected_runtime_path=$(
        IFS=:
        printf '%s' "${expected_path_entries[*]}"
      )
      [[ "$create_invocation" == *"--env PATH=$expected_runtime_path:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"* ]] ||
        fail "$case_name machine create is missing selected environment PATH entries"
      expected_pack_path="$expected_runtime_path:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin"
      assert_file_contains "$SMOLVM_SMOLFILE_LOG" "PATH=$expected_pack_path"
    else
      [[ "$create_invocation" != *'--env PATH='* ]] ||
        fail "$case_name unexpectedly overrides the base PATH"
      assert_file_contains "$SMOLVM_SMOLFILE_LOG" \
        'PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin'
    fi
    for environment_name in rust go python; do
      machine_exec_system_install="machine exec --name $vm_name -- /bin/sh /opt/ompact-env/$environment_name.sh install-system "
      machine_exec_user_install="machine exec --name $vm_name --user omp -- /bin/sh /opt/ompact-env/$environment_name.sh install-user "
      machine_exec_check="machine exec --name $vm_name --user omp -- /bin/sh /opt/ompact-env/$environment_name.sh check "
      packaged_check="packaged-launcher run --user omp -v $environment_volume -- /bin/sh /opt/ompact-env/$environment_name.sh check "
      if [[ " ${expected_environments[*]} " == *" $environment_name "* ]]; then
        assert_log_line_equals "$machine_exec_system_install"
        assert_log_line_equals "$machine_exec_user_install"
        assert_log_order "$machine_exec_system_install" "$machine_exec_user_install"
        assert_log_line_equals "$machine_exec_check"
        assert_log_order "$machine_exec_user_install" "$machine_exec_check"
        assert_log_line_equals "$packaged_check"
        case "$environment_name" in
        rust)
          for expected_env in \
            "RUST_TOOLCHAIN=$RUST_TOOLCHAIN" \
            "CARGO_AUDIT_VERSION=$CARGO_AUDIT_VERSION" \
            "CARGO_DENY_VERSION=$CARGO_DENY_VERSION" \
            "CARGO_NEXTEST_VERSION=$CARGO_NEXTEST_VERSION" \
            "CARGO_LLVM_COV_VERSION=$CARGO_LLVM_COV_VERSION" \
            "RUSTUP_HOME=$RUSTUP_HOME" \
            "CARGO_HOME=$CARGO_HOME"; do
            [[ "$create_invocation" == *"--env $expected_env"* ]] ||
              fail "$case_name machine create is missing: --env $expected_env"
          done
          ;;
        go)
          for expected_env in \
            "GO_VERSION=$GO_VERSION" \
            "GOBIN=$GOBIN" \
            "GOPLS_VERSION=$GOPLS_VERSION" \
            "GOVULNCHECK_VERSION=$GOVULNCHECK_VERSION" \
            "STATICCHECK_VERSION=$STATICCHECK_VERSION" \
            "GOLANGCI_LINT_VERSION=$GOLANGCI_LINT_VERSION"; do
            [[ "$create_invocation" == *"--env $expected_env"* ]] ||
              fail "$case_name machine create is missing: --env $expected_env"
          done
          for go_path_env in GOROOT GOPATH GOMODCACHE GOCACHE; do
            assert_log_not_contains "--env $go_path_env="
          done
          ;;
        python)
          for expected_env in \
            "UV_VERSION=$UV_VERSION" \
            "UV_CACHE_DIR=$UV_CACHE_DIR"; do
            [[ "$create_invocation" == *"--env $expected_env"* ]] ||
              fail "$case_name machine create is missing: --env $expected_env"
          done
          ;;
        esac
      else
        assert_log_not_contains "$machine_exec_system_install"
        assert_log_not_contains "$machine_exec_user_install"
        assert_log_not_contains "$machine_exec_check"
        assert_log_not_contains "$packaged_check"
      fi
    done
  else
    assert_log_not_contains '--volume'
    assert_log_not_contains '--env'
    assert_log_not_contains '/opt/ompact-env'
    assert_log_not_contains 'machine update'
    assert_log_not_contains 'packaged-launcher run -v'
    assert_file_contains "$SMOLVM_SMOLFILE_LOG" \
      'PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin'
    if [[ "$case_name" == default || "$case_name" == empty-argument ]]; then
      assert_output_line_equals 'no environments selected'
    fi
  fi
}

run_rejected_case() {
  local case_name="$1"
  local expected_message="$2"
  local output="$WORKDIR/ompact-$case_name"
  local build_status

  rm -f -- "$STATUS_COUNT" "$output" "$output.smolmachine"
  [[ ! -e /tmp/ompact.smolmachine &&
    ! -L /tmp/ompact.smolmachine ]] ||
    fail "$case_name found a pre-existing legacy sidecar"
  case "$case_name" in
  output-directory)
    mkdir "$output"
    ;;
  sidecar)
    : >"$output.smolmachine"
    ;;
  legacy-sidecar)
    : >/tmp/ompact.smolmachine
    ;;
  esac

  : >"$SMOLVM_LOG"
  export OUTPUT="$output"
  export VM_NAME="omp-package-builder-$case_name"
  set +e
  "$PROJECT_ROOT/build.sh" >"$BUILD_OUTPUT" 2>&1
  build_status=$?
  set -e
  ((build_status != 0)) ||
    fail "$case_name unexpectedly succeeded"
  log_contents="$(<"$SMOLVM_LOG")"
  assert_log_not_contains 'machine create'
  [[ "$(<"$BUILD_OUTPUT")" == *"$expected_message"* ]] ||
    fail "$case_name did not report: $expected_message"

  case "$case_name" in
  output-directory)
    rmdir "$output"
    ;;
  sidecar)
    rm -f -- "$output.smolmachine"
    ;;
  legacy-sidecar)
    rm -f -- /tmp/ompact.smolmachine
    ;;
  esac
}

run_failure_cleanup_case() {
  local build_status
  local create_invocation
  local vm_name
  rm -f -- "$STATUS_COUNT" "$WORKDIR/ompact-failure" "$WORKDIR/ompact-failure.smolmachine"
  : >"$SMOLVM_LOG"
  export OUTPUT="$WORKDIR/ompact-failure"
  set +e
  SMOLVM_FAIL_ON=machine:start SMOLVM_FAIL_STATUS=4 \
    "$PROJECT_ROOT/build.sh" >"$BUILD_OUTPUT" 2>&1
  build_status=$?
  set -e
  ((build_status == 4)) || fail "failure case returned status $build_status, expected 4"
  assert_file_contains "$BUILD_OUTPUT" 'build.sh failed in command block starting at line'
  assert_file_contains "$BUILD_OUTPUT" 'exit status 4'
  assert_file_contains "$BUILD_OUTPUT" "smolvm machine start --name \"\$VM_NAME\""
  log_contents="$(<"$SMOLVM_LOG")"
  create_invocation="$(find_log_line 'machine create ')" ||
    fail 'failure case is missing machine create invocation'
  if [[ "$create_invocation" =~ --name[[:space:]]+(omp-package-builder-[^[:space:]]+) ]]; then
    vm_name="${BASH_REMATCH[1]}"
  else
    fail 'failure case machine create did not use a generated VM name'
  fi
  assert_log_contains "machine stop --name $vm_name "
  assert_log_contains "machine delete --name $vm_name --force "
}
run_environment_failure_case() {
  local build_status
  local output="$WORKDIR/ompact-go-install-failure"
  rm -f -- "$STATUS_COUNT" "$output" "$output.smolmachine"
  : >"$SMOLVM_LOG"
  export OUTPUT="$output"

  set +e
  SMOLVM_FAIL_ON=machine:exec \
    SMOLVM_FAIL_MATCH='/opt/ompact-env/go.sh install-system' \
    SMOLVM_FAIL_STATUS=4 \
    "$PROJECT_ROOT/build.sh" rust,go >"$BUILD_OUTPUT" 2>&1
  build_status=$?
  set -e

  ((build_status == 4)) ||
    fail "Go SDK failure returned status $build_status, expected 4"
  assert_file_contains "$BUILD_OUTPUT" 'go system installation failed (exit status 4)'
  assert_file_contains "$BUILD_OUTPUT" '/opt/ompact-env/go.sh install-system'
}

run_signal_cleanup_case() {
  local build_status
  local vm_name
  local build_pid
  local retries
  local invocation

  rm -f -- "$WORKDIR/ompact-signal" "$WORKDIR/ompact-signal.smolmachine"
  : >"$SMOLVM_LOG"
  export OUTPUT="$WORKDIR/ompact-signal"

  set +e
  SMOLVM_SLEEP=3 "$PROJECT_ROOT/build.sh" >"$BUILD_OUTPUT" 2>&1 &
  build_pid=$!

  retries=60
  while ((retries > 0)); do
    if [[ -f "$SMOLVM_LOG" ]] &&
      grep -q "machine start --name omp-package-builder-.*-$build_pid " "$SMOLVM_LOG"; then
      break
    fi
    sleep 0.1
    retries=$((retries - 1))
  done
  ((retries > 0)) || fail 'signal case: machine start never reached'

  while IFS= read -r invocation; do
    if [[ "$invocation" =~ ^machine[[:space:]]create[[:space:]]--name[[:space:]]+(omp-package-builder-[^[:space:]]*-$build_pid)[[:space:]] ]]; then
      vm_name="${BASH_REMATCH[1]}"
      break
    fi
  done <"$SMOLVM_LOG"
  [[ -n "$vm_name" ]] || fail 'signal case is missing generated VM name'

  kill -TERM "$build_pid" 2>/dev/null || true
  wait "$build_pid"
  build_status=$?
  set -e

  ((build_status != 0)) || fail 'signal case unexpectedly succeeded'
  log_contents="$(<"$SMOLVM_LOG")"
  assert_log_contains "machine stop --name $vm_name "
  assert_log_contains "machine delete --name $vm_name --force "
}

run_generated_create_failure_case() {
  local build_status
  local create_invocation
  local generated_vm_name

  rm -f -- "$WORKDIR/ompact-generated-failure" \
    "$WORKDIR/ompact-generated-failure.smolmachine"
  : >"$SMOLVM_LOG"
  export OUTPUT="$WORKDIR/ompact-generated-failure"

  set +e
  SMOLVM_EXISTING=1 "$PROJECT_ROOT/build.sh" >"$BUILD_OUTPUT" 2>&1
  build_status=$?
  set -e

  ((build_status != 0)) ||
    fail 'generated create failure unexpectedly succeeded'

  log_contents="$(<"$SMOLVM_LOG")"
  create_invocation="$(find_log_line 'machine create ')" ||
    fail 'generated create failure is missing machine create invocation'

  if [[ "$create_invocation" =~ --name[[:space:]]+(omp-package-builder-[^[:space:]]+) ]]; then
    generated_vm_name="${BASH_REMATCH[1]}"
  else
    fail 'generated VM name was not unique'
  fi

  assert_log_contains "machine stop --name $generated_vm_name "
  assert_log_contains "machine delete --name $generated_vm_name --force "
}
run_invalid_selection_case() {
  local selection="$1"
  local expected_message="$2"
  local invalid_status
  local existing_output='existing artifact'
  : >"$SMOLVM_LOG"
  rm -f -- "$STATUS_COUNT"
  export OUTPUT="$WORKDIR/ompact-invalid-$selection"
  printf '%s\n' "$existing_output" >"$OUTPUT"
  set +e
  "$PROJECT_ROOT/build.sh" "$selection" >"$BUILD_OUTPUT" 2>&1
  invalid_status=$?
  set -e
  ((invalid_status != 0)) ||
    fail "invalid environment selection unexpectedly succeeded: $selection"

  [[ -f "$OUTPUT" ]] ||
    fail "invalid selection removed the existing output"
  [[ "$(<"$OUTPUT")" == "$existing_output" ]] ||
    fail "invalid selection changed the existing output"

  log_contents="$(<"$SMOLVM_LOG")"
  assert_log_not_contains 'machine create'
  [[ "$(<"$BUILD_OUTPUT")" == *"$expected_message"* ]] ||
    fail "invalid selection did not report: $expected_message"
}

run_custom_environment_case() {
  local custom_project="$WORKDIR/custom-project"
  local custom_output="$WORKDIR/ompact-custom"
  local create_invocation
  local environment_key

  mkdir -p "$custom_project/env"
  custom_project="$(cd "$custom_project" && pwd)"
  cp "$PROJECT_ROOT/build.sh" "$custom_project/build.sh"
  cp "$PROJECT_ROOT/Smolfile" "$custom_project/Smolfile"
  for environment_name in custom extra; do
    case "$environment_name" in
    custom) environment_key=CUSTOM_ENV_VALUE ;;
    extra) environment_key=EXTRA_ENV_VALUE ;;
    esac
    cat >"$custom_project/env/$environment_name.sh" <<CUSTOM_ENVIRONMENT
#!/bin/sh
set -eu
case "\${1:-}" in
defaults)
  printf '$environment_key=from-fixture\\n'
  printf 'ENV_PATH=/home/omp/.local/envs/$environment_name/bin\\n'
  ;;
install-system|install-user|check)
  [ "\$#" -eq 1 ]
  ;;
*)
  exit 2
  ;;
esac
CUSTOM_ENVIRONMENT
    chmod +x "$custom_project/env/$environment_name.sh"
  done

  : >"$SMOLVM_SMOLFILE_LOG"
  : >"$SMOLVM_LOG"
  export OUTPUT="$custom_output"
  "$custom_project/build.sh" custom,extra >"$BUILD_OUTPUT" 2>&1 || {
    printf 'custom environment build failed:\n%s\n' "$(<"$BUILD_OUTPUT")" >&2
    exit 1
  }

  log_contents="$(<"$SMOLVM_LOG")"
  create_invocation="$(find_log_line 'machine create ')" ||
    fail 'custom environment is missing machine create invocation'
  if [[ "$create_invocation" =~ --name[[:space:]]+(omp-package-builder-[^[:space:]]+) ]]; then
    vm_name="${BASH_REMATCH[1]}"
  else
    fail 'custom environment machine create did not use a generated VM name'
  fi

  for environment_name in custom extra; do
    case "$environment_name" in
    custom) environment_key=CUSTOM_ENV_VALUE ;;
    extra) environment_key=EXTRA_ENV_VALUE ;;
    esac
    [[ "$create_invocation" == *"--env $environment_key=from-fixture"* ]] ||
      fail "$environment_name default was not forwarded"
    assert_log_line_equals \
      "machine exec --name $vm_name -- /bin/sh /opt/ompact-env/$environment_name.sh install-system "
    assert_log_line_equals \
      "machine exec --name $vm_name --user omp -- /bin/sh /opt/ompact-env/$environment_name.sh install-user "
    assert_log_line_equals \
      "machine exec --name $vm_name --user omp -- /bin/sh /opt/ompact-env/$environment_name.sh check "
    assert_log_line_equals \
      "packaged-launcher run --user omp -v $custom_project/env:/opt/ompact-env:ro -- /bin/sh /opt/ompact-env/$environment_name.sh check "
  done
  [[ "$create_invocation" == *'--env PATH=/home/omp/.local/envs/custom/bin:/home/omp/.local/envs/extra/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin'* ]] ||
    fail 'custom environment PATH contributions were not combined in selection order'
  [[ "$create_invocation" != *'--env ENV_PATH='* ]] ||
    fail 'environment PATH metadata was passed through as a guest variable'
  assert_file_contains "$SMOLVM_SMOLFILE_LOG" \
    'PATH=/home/omp/.local/envs/custom/bin:/home/omp/.local/envs/extra/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin'
}

run_custom_environment_case

run_rejected_case output-directory 'output exists and is not a regular file'
run_rejected_case sidecar 'unexpected sidecar exists'
run_rejected_case legacy-sidecar 'unexpected legacy sidecar exists'
run_generated_create_failure_case
run_failure_cleanup_case
run_environment_failure_case

run_signal_cleanup_case

run_case default ''
EXPLICIT_EMPTY_ARGUMENT=1 run_case empty-argument ''
run_case rust rust rust
run_case go go go
run_case python python python
run_case combo go,rust,python go rust python
RUST_TOOLCHAIN=nightly run_case rust-override rust rust
unset CPUS MEMORY
run_case no-resources ''
: >"$SMOLVM_LOG"
rm -f -- "$STATUS_COUNT"
export OUTPUT="$WORKDIR/ompact-invalid"
set +e
"$PROJECT_ROOT/build.sh" swift >"$BUILD_OUTPUT" 2>&1
invalid_status=$?
set -e
((invalid_status != 0)) || fail 'invalid environment unexpectedly succeeded'
log_contents="$(<"$SMOLVM_LOG")"
assert_log_not_contains 'machine create'
[[ "$(cat "$BUILD_OUTPUT")" == *'unknown environment: swift'* ]] ||
  fail 'invalid environment error did not identify swift'

run_invalid_selection_case go,go 'duplicate: go'
run_invalid_selection_case go, 'empty name'
printf 'host orchestration harness passed\n'
