#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/ompact-build-test.XXXXXX")"
FAKE_SMOLVM="$WORKDIR/smolvm"
SMOLVM_LOG="$WORKDIR/smolvm.log"
STATUS_COUNT="$WORKDIR/status-count"
BUILD_OUTPUT="$WORKDIR/build.out"

cleanup() {
  rm -rf -- "$WORKDIR"
}
trap cleanup EXIT

fail() {
  printf 'assertion failed: %s\n' "$*" >&2
  exit 1
}
assert_file_contains() {
  local file="$1"
  local needle="$2"
  local contents
  contents="$(<"$file")"
  [[ "$contents" == *"$needle"* ]] ||
    fail "$file is missing: $needle"
}

assert_file_not_contains() {
  local file="$1"
  local needle="$2"
  local contents
  contents="$(<"$file")"
  [[ "$contents" != *"$needle"* ]] ||
    fail "$file unexpectedly contains: $needle"
}

assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'image = "debian:trixie-slim@sha256:d7e12182ce18b85b93007c1dedf31f2d29e01ccf3182cc4017c709b6259bc132"'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'cmd = ["--"]'
assert_file_not_contains "$PROJECT_ROOT/build.sh" \
  'SMOLVM_BIN'
assert_file_not_contains "$PROJECT_ROOT/build.sh" \
  "VM_NAME=\"\${VM_NAME:-"
assert_file_not_contains "$PROJECT_ROOT/build.sh" \
  "SMOLFILE=\"\${SMOLFILE:-"
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'snapshot.debian.org/archive/debian/20260820T000000Z trixie'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'trixie-security main'
assert_file_contains "$PROJECT_ROOT/Smolfile" \
  'omp_version=v18.1.9'
