#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/ompact-update-omp-test.XXXXXX")"

cleanup() {
  rm -rf -- "$WORKDIR"
}
trap cleanup EXIT

fail() {
  printf 'assertion failed: %s\n' "$*" >&2
  exit 1
}

assert_file_contains() {
  local file="$1"
  local needle="$2"
  local contents
  contents="$(<"$file")"
  [[ "$contents" == *"$needle"* ]] ||
    fail "$file is missing: $needle"
}

assert_file_not_contains() {
  local file="$1"
  local needle="$2"
  local contents
  contents="$(<"$file")"
  [[ "$contents" != *"$needle"* ]] ||
    fail "$file unexpectedly contains: $needle"
}

workflow="$PROJECT_ROOT/.github/workflows/update-omp.yml"
release_json="$WORKDIR/release.json"
printf '%s\n' '{"draft":false,"prerelease":false}' >"$release_json"

[[ "$(jq -r '.draft == false' "$release_json")" == true ]] ||
  fail 'published release draft flag was rejected'
[[ "$(jq -r '.prerelease == false' "$release_json")" == true ]] ||
  fail 'stable release prerelease flag was rejected'
assert_file_contains "$workflow" '.draft == false'
assert_file_contains "$workflow" '.prerelease == false'

cp -- "$PROJECT_ROOT/Smolfile" "$WORKDIR/Smolfile"
mkdir -- "$WORKDIR/tests"
cp -- "$PROJECT_ROOT/tests/build.sh.test" "$WORKDIR/tests/build.sh.test"
previous_version="$(sed -n 's/^omp_version=//p' "$WORKDIR/Smolfile")"

new_version=v99.98.97
arm64_sha="$(printf 'a%.0s' {1..64})"
amd64_sha="$(printf 'b%.0s' {1..64})"

"$PROJECT_ROOT/scripts/update-omp.sh" \
  "$new_version" "$arm64_sha" "$amd64_sha" "$WORKDIR"

assert_file_contains "$WORKDIR/Smolfile" "omp_version=$new_version"
assert_file_contains "$WORKDIR/Smolfile" "omp_sha256=$arm64_sha"
assert_file_contains "$WORKDIR/Smolfile" "omp_sha256=$amd64_sha"
assert_file_contains "$WORKDIR/Smolfile" 'jj_version=v0.44.0'
assert_file_contains "$WORKDIR/tests/build.sh.test" "omp_version=$new_version"
assert_file_contains "$WORKDIR/tests/build.sh.test" "omp_sha256=$arm64_sha"
assert_file_contains "$WORKDIR/tests/build.sh.test" "omp_sha256=$amd64_sha"
assert_file_not_contains "$WORKDIR/Smolfile" "omp_version=$previous_version"

before_invalid="$(<"$WORKDIR/Smolfile")"
if "$PROJECT_ROOT/scripts/update-omp.sh" "$new_version" invalid "$amd64_sha" "$WORKDIR" >/dev/null 2>&1; then
  fail 'invalid arm64 checksum was accepted'
fi
[[ "$(<"$WORKDIR/Smolfile")" == "$before_invalid" ]] ||
  fail 'invalid input changed Smolfile'
