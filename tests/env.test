#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/ompact-env-test.XXXXXX")"
trap 'rm -rf -- "$WORKDIR"' EXIT

FAKE_PATH="$WORKDIR/bin"
OUTPUT="$WORKDIR/output"
mkdir "$FAKE_PATH"

set +e
PATH="$FAKE_PATH" "$PROJECT_ROOT/env/go.sh" install-sdk >"$OUTPUT" 2>&1
STATUS=$?
set -e

((STATUS != 0)) || {
  printf 'go install unexpectedly succeeded without jq\n' >&2
  exit 1
}
OUTPUT_CONTENTS="$(<"$OUTPUT")"
[[ "$OUTPUT_CONTENTS" == *'jq is required to install Go'* ]] || {
  printf 'missing jq error was not reported:\n%s\n' "$OUTPUT_CONTENTS" >&2
  exit 1
}

RUST_BIN="$WORKDIR/rust-bin"
RUST_CARGO_HOME="$WORKDIR/rust-cargo"
RUSTUP_HOME="$WORKDIR/rustup"
mkdir -p "$RUST_BIN" "$RUST_CARGO_HOME/bin" "$RUSTUP_HOME/toolchains/test" \
  "$RUST_CARGO_HOME/registry/index" "$RUST_CARGO_HOME/git"
: >"$RUST_CARGO_HOME/registry/index/stale"
: >"$RUST_CARGO_HOME/git/preserved"
: >"$RUST_CARGO_HOME/bin/rustup"
chmod +x "$RUST_CARGO_HOME/bin/rustup"
cat >"$RUST_BIN/cargo" <<'FAKE_CARGO'
#!/usr/bin/env bash
set -Eeuo pipefail
[[ "$1" == install ]] || exit 2
mkdir -p "$CARGO_HOME/registry/cache/test" "$CARGO_HOME/registry/src/test"
printf '%s\n' "$*" >"$CARGO_HOME/registry/cache/test/install"
FAKE_CARGO
chmod +x "$RUST_BIN/cargo"
PATH="$RUST_BIN:/usr/bin:/bin" \
  CARGO_HOME="$RUST_CARGO_HOME" RUSTUP_HOME="$RUSTUP_HOME" \
  "$PROJECT_ROOT/env/rust.sh" install-tools >"$OUTPUT" 2>&1 || {
  printf 'Rust install-tools failed:\n%s\n' "$(<"$OUTPUT")" >&2
  exit 1
}
[[ -d "$RUST_CARGO_HOME/registry" ]] || {
  printf 'Rust install-tools removed the Cargo registry directory\n' >&2
  exit 1
}
registry_contents=$(find "$RUST_CARGO_HOME/registry" -mindepth 1 -print -quit)
[[ -z "$registry_contents" ]] || {
  printf 'Rust setup left Cargo registry content: %s\n' "$registry_contents" >&2
  exit 1
}
[[ -x "$RUST_CARGO_HOME/bin/rustup" ]] || {
  printf 'Rust setup removed the Cargo home bin directory\n' >&2
  exit 1
}
[[ -f "$RUST_CARGO_HOME/git/preserved" ]] || {
  printf 'Rust setup removed the separate Cargo git cache\n' >&2
  exit 1
}

printf 'environment harness passed\n'
