#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/ompact-env-test.XXXXXX")"
trap 'chmod -R u+w "$WORKDIR"; rm -rf -- "$WORKDIR"' EXIT

FAKE_PATH="$WORKDIR/bin"
OUTPUT="$WORKDIR/output"
mkdir "$FAKE_PATH"

set +e
PATH="$FAKE_PATH" "$PROJECT_ROOT/env/go.sh" install-system >"$OUTPUT" 2>&1
STATUS=$?
set -e

((STATUS != 0)) || {
  printf 'go install unexpectedly succeeded without jq\n' >&2
  exit 1
}
OUTPUT_CONTENTS="$(<"$OUTPUT")"
[[ "$OUTPUT_CONTENTS" == *'jq is required to install Go'* ]] || {
  printf 'missing jq error was not reported:\n%s\n' "$OUTPUT_CONTENTS" >&2
  exit 1
}
MISSING_GO_PATH="$WORKDIR/missing-go-bin"
mkdir "$MISSING_GO_PATH"
cat >"$MISSING_GO_PATH/dpkg" <<'FAKE_DPKG'
#!/bin/sh
[ "${1:-}" = --print-architecture ] || exit 2
printf 'arm64\n'
FAKE_DPKG
cat >"$MISSING_GO_PATH/curl" <<'FAKE_CURL'
#!/bin/sh
[ "${1:-}" = -fsSLo ] && [ -n "${2:-}" ] || exit 2
printf '[]\n' >"$2"
FAKE_CURL
cat >"$MISSING_GO_PATH/jq" <<'FAKE_JQ'
#!/bin/sh
exit 4
FAKE_JQ
chmod +x "$MISSING_GO_PATH/dpkg" "$MISSING_GO_PATH/curl" \
  "$MISSING_GO_PATH/jq"
set +e
PATH="$MISSING_GO_PATH:/usr/bin:/bin" \
  "$PROJECT_ROOT/env/go.sh" install-system >"$OUTPUT" 2>&1
STATUS=$?
set -e
((STATUS == 1)) || {
  printf 'missing Go version returned status %d, expected 1\n' "$STATUS" >&2
  exit 1
}
OUTPUT_CONTENTS="$(<"$OUTPUT")"
[[ "$OUTPUT_CONTENTS" == *'Go release go1.27.2 has no linux/arm64 archive in download metadata'* ]] || {
  printf 'missing Go version error was not reported:\n%s\n' "$OUTPUT_CONTENTS" >&2
  exit 1
}

PINNED_GO_PATH="$WORKDIR/pinned-go-bin"
PINNED_GO_ROOT="$WORKDIR/pinned-go-root"
CURL_LOG="$WORKDIR/pinned-go-curl.log"
mkdir "$PINNED_GO_PATH"
ln -s "$MISSING_GO_PATH/dpkg" "$PINNED_GO_PATH/dpkg"
cat >"$PINNED_GO_PATH/curl" <<'FAKE_CURL'
#!/bin/sh
[ "${1:-}" = -fsSLo ] && [ -n "${2:-}" ] && [ -n "${3:-}" ] || exit 2
case "$3" in
*'mode=json&include=all')
  cat >"$2" <<'JSON'
[
  {"version":"go1.27.2","files":[
    {"filename":"go1.27.2.linux-arm64.tar.gz","os":"linux","arch":"arm64","kind":"archive","sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
  ]},
  {"version":"go1.27.1","files":[
    {"filename":"go1.27.1.linux-arm64.tar.gz","os":"linux","arch":"arm64","kind":"archive","sha256":"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}
  ]}
]
JSON
  ;;
*'mode=json')
  cat >"$2" <<'JSON'
[
  {"version":"go1.27.2","files":[
    {"filename":"go1.27.2.linux-arm64.tar.gz","os":"linux","arch":"arm64","kind":"archive","sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}
  ]}
]
JSON
  ;;
https://go.dev/dl/go1.27.1.linux-arm64.tar.gz)
  printf '%s\n' "$3" >>"$CURL_LOG"
  exit 37
  ;;
*)
  printf 'unexpected Go download URL: %s\n' "$3" >&2
  exit 2
  ;;
esac
FAKE_CURL
chmod +x "$PINNED_GO_PATH/curl"
set +e
CURL_LOG="$CURL_LOG" GO_VERSION=go1.27.1 GO_ROOT="$PINNED_GO_ROOT" \
  PATH="$PINNED_GO_PATH:$PATH" \
  "$PROJECT_ROOT/env/go.sh" install-system >"$OUTPUT" 2>&1
STATUS=$?
set -e
((STATUS == 37)) || {
  printf 'pinned Go archive lookup returned status %d, expected 37:\n%s\n' \
    "$STATUS" "$(<"$OUTPUT")" >&2
  exit 1
}
[[ -f "$CURL_LOG" ]] || {
  printf 'pinned Go archive was not requested:\n%s\n' "$(<"$OUTPUT")" >&2
  exit 1
}
[[ "$(<"$CURL_LOG")" == 'https://go.dev/dl/go1.27.1.linux-arm64.tar.gz' ]] || {
  printf 'unexpected pinned Go archive request: %s\n' "$(<"$CURL_LOG")" >&2
  exit 1
}

RUST_BIN="$WORKDIR/rust-bin"
RUST_CARGO_HOME="$WORKDIR/rust-cargo"
RUSTUP_HOME="$WORKDIR/rustup"
mkdir -p "$RUST_BIN" "$RUST_CARGO_HOME/bin" "$RUSTUP_HOME/toolchains/test" \
  "$RUST_CARGO_HOME/registry/index" "$RUST_CARGO_HOME/git"
: >"$RUST_CARGO_HOME/registry/index/stale"
: >"$RUST_CARGO_HOME/git/preserved"
: >"$RUST_CARGO_HOME/bin/rustup"
chmod +x "$RUST_CARGO_HOME/bin/rustup"
cat >"$RUST_CARGO_HOME/bin/cargo" <<'FAKE_CARGO'
#!/usr/bin/env bash
set -Eeuo pipefail
case "${1:-}" in
install)
  tool="${@: -1}"
  mkdir -p "$CARGO_HOME/bin"
  printf '#!/bin/sh\nexit 0\n' >"$CARGO_HOME/bin/$tool"
  chmod +x "$CARGO_HOME/bin/$tool"
  mkdir -p "$CARGO_HOME/registry/cache/test" "$CARGO_HOME/registry/src/test"
  printf '%s\n' "$*" >"$CARGO_HOME/registry/cache/test/install"
  ;;
llvm-cov)
  [[ "${2:-}" != --version ]] || exit 0
  while (($#)); do
    if [[ "$1" == --output-path ]]; then
      printf '{"file":"src/lib.rs"}\n' >"$2"
      exit 0
    fi
    shift
  done
  exit 2
  ;;
--version|clippy)
  ;;
*)
  exit 2
  ;;
esac
FAKE_CARGO
chmod +x "$RUST_CARGO_HOME/bin/cargo"
for tool in cargo rustc rustfmt rust-analyzer cargo-audit cargo-deny \
  cargo-nextest cargo-llvm-cov; do
  printf '#!/bin/sh\nexit 91\n' >"$RUST_BIN/$tool"
  chmod +x "$RUST_BIN/$tool"
done
PATH="$RUST_BIN:/usr/bin:/bin" \
  CARGO_HOME="$RUST_CARGO_HOME" CARGO_INSTALL_ROOT="$RUST_CARGO_HOME" \
  RUSTUP_HOME="$RUSTUP_HOME" \
  "$PROJECT_ROOT/env/rust.sh" install-user >"$OUTPUT" 2>&1 || {
  printf 'Rust install-user failed:\n%s\n' "$(<"$OUTPUT")" >&2
  exit 1
}
[[ -d "$RUST_CARGO_HOME/registry" ]] || {
  printf 'Rust install-user removed the Cargo registry directory\n' >&2
  exit 1
}
registry_contents=$(find "$RUST_CARGO_HOME/registry" -mindepth 1 -print -quit)
[[ -z "$registry_contents" ]] || {
  printf 'Rust setup left Cargo registry content: %s\n' "$registry_contents" >&2
  exit 1
}
[[ -x "$RUST_CARGO_HOME/bin/rustup" ]] || {
  printf 'Rust setup removed the Cargo home bin directory\n' >&2
  exit 1
}
[[ -f "$RUST_CARGO_HOME/git/preserved" ]] || {
  printf 'Rust setup removed the separate Cargo git cache\n' >&2
  exit 1
}

for tool in cargo-audit cargo-deny cargo-nextest cargo-llvm-cov; do
  [[ -x "$RUST_CARGO_HOME/bin/$tool" ]] || {
    printf 'Rust tool was not installed in CARGO_HOME/bin: %s\n' "$tool" >&2
    exit 1
  }
done
cat >"$RUST_CARGO_HOME/bin/rustc" <<'FAKE_RUSTC'
#!/usr/bin/env bash
set -Eeuo pipefail
if [[ "$*" == '--print sysroot' ]]; then
  printf '%s/toolchains/test\n' "$RUSTUP_HOME"
  exit 0
fi
wasm=0
while (($#)); do
  case "$1" in
  --target) wasm=1; shift 2 ;;
  -o)
    if ((wasm)); then
      printf '\0asm' >"$2"
    else
      printf '#!/bin/sh\nprintf "rust-ok\\n"\n' >"$2"
      chmod +x "$2"
    fi
    exit 0
    ;;
  *) shift ;;
  esac
done
FAKE_RUSTC
chmod +x "$RUST_CARGO_HOME/bin/rustc"
for tool in rustfmt rust-analyzer; do
  printf '#!/bin/sh\nexit 0\n' >"$RUST_CARGO_HOME/bin/$tool"
  chmod +x "$RUST_CARGO_HOME/bin/$tool"
done
mkdir "$RUSTUP_HOME/toolchains/test/bin"
cp "$RUST_CARGO_HOME/bin/rustc" "$RUSTUP_HOME/toolchains/test/bin/rustc"
chmod -R a-w "$RUSTUP_HOME"
PATH="$RUST_BIN:$RUST_CARGO_HOME/bin:/usr/bin:/bin" \
  CARGO_HOME="$RUST_CARGO_HOME" RUSTUP_HOME="$RUSTUP_HOME" \
  "$PROJECT_ROOT/env/rust.sh" check >"$OUTPUT" 2>&1 || {
  printf 'Rust check rejected earlier environment commands:\n%s\n' "$(<"$OUTPUT")" >&2
  exit 1
}
GO_TEST_HOME="$WORKDIR/go-home"
GO_TEST_ROOT="$WORKDIR/go-root"
GO_TEST_GOBIN="$GO_TEST_HOME/go/bin"
mkdir -p "$GO_TEST_ROOT/bin" "$GO_TEST_HOME/.cache/uv"
printf 'preserve me\n' >"$GO_TEST_HOME/.cache/uv/sentinel"
cat >"$GO_TEST_ROOT/bin/go" <<'FAKE_GO'
#!/bin/sh
set -eu
case "${1:-}" in
env)
  case "${2:-}" in
  GOPATH) printf '%s/go\n' "$HOME" ;;
  GOBIN) printf '%s\n' "$GOBIN" ;;
  GOMODCACHE) printf '%s/go/pkg/mod\n' "$HOME" ;;
  GOCACHE) printf '%s/.cache/go-build\n' "$HOME" ;;
  *) exit 2 ;;
  esac
  ;;
telemetry)
  [ "${2:-}" = off ]
  ;;
install)
  mkdir -p "$HOME/go/pkg/mod/install" "$HOME/.cache/go-build/install" "$GOBIN"
  tool=${2%@*}
  tool=${tool##*/}
  printf '#!/bin/sh\nexit 0\n' >"$GOBIN/$tool"
  chmod +x "$GOBIN/$tool"
  ;;
*)
  exit 2
  ;;
esac
FAKE_GO
chmod +x "$GO_TEST_ROOT/bin/go"
HOME="$GO_TEST_HOME" GO_ROOT="$GO_TEST_ROOT" GOBIN="$GO_TEST_GOBIN" \
  "$PROJECT_ROOT/env/go.sh" install-user >"$OUTPUT" 2>&1 || {
  printf 'Go install-user failed:\n%s\n' "$(<"$OUTPUT")" >&2
  exit 1
}
for tool in gopls govulncheck staticcheck golangci-lint; do
  [[ -x "$GO_TEST_GOBIN/$tool" ]] || {
    printf 'Go cleanup removed the installed tool from GOPATH/bin: %s\n' "$tool" >&2
    exit 1
  }
done
[[ -f "$GO_TEST_HOME/.cache/uv/sentinel" ]] || {
  printf 'Go cleanup removed another environment cache\n' >&2
  exit 1
}
[[ -d "$GO_TEST_HOME/.cache/go-build" ]] &&
  [[ -z "$(find "$GO_TEST_HOME/.cache/go-build" -mindepth 1 -print -quit)" ]] || {
  printf 'Go build cache was not cleaned\n' >&2
  exit 1
}

for unsafe_bin in gopath-root gopath-child cache-root cache-child cache-alias; do
  unsafe_home="$WORKDIR/$unsafe_bin"
  case "$unsafe_bin" in
  gopath-root) unsafe_gobin="$unsafe_home/go" ;;
  gopath-child) unsafe_gobin="$unsafe_home/go/tools/bin" ;;
  cache-root) unsafe_gobin="$unsafe_home/.cache/go-build" ;;
  cache-child) unsafe_gobin="$unsafe_home/.cache/go-build/tools/bin" ;;
  cache-alias)
    mkdir -p "$unsafe_home/.cache/go-build"
    unsafe_gobin="$unsafe_home/tools"
    ln -s "$unsafe_home/.cache/go-build" "$unsafe_gobin"
    ;;
  esac
  mkdir -p "$unsafe_gobin"
  printf '#!/bin/sh\nprintf "existing-tool\\n"\n' >"$unsafe_gobin/gopls"
  chmod +x "$unsafe_gobin/gopls"
  if HOME="$unsafe_home" GO_ROOT="$GO_TEST_ROOT" GOBIN="$unsafe_gobin" \
    "$PROJECT_ROOT/env/go.sh" install-user >"$OUTPUT" 2>&1; then
    printf 'Go accepted a GOBIN overlapping install cleanup: %s\n' "$unsafe_bin" >&2
    exit 1
  fi
  [[ "$("$unsafe_gobin/gopls")" == existing-tool ]] || {
    printf 'Go changed installed tools before rejecting GOBIN: %s\n' "$unsafe_bin" >&2
    exit 1
  }
done

for safe_bin in equivalent isolated; do
  safe_home="$WORKDIR/$safe_bin"
  case "$safe_bin" in
  equivalent) safe_gobin="$safe_home/go//bin/../bin/./" ;;
  isolated) safe_gobin="$safe_home/.local/envs/go/bin" ;;
  esac
  mkdir -p "$safe_home"
  HOME="$safe_home" GO_ROOT="$GO_TEST_ROOT" GOBIN="$safe_gobin" \
    "$PROJECT_ROOT/env/go.sh" install-user >"$OUTPUT" 2>&1 || {
    printf 'Go rejected a safe GOBIN (%s):\n%s\n' "$safe_bin" "$(<"$OUTPUT")" >&2
    exit 1
  }
  for tool in gopls govulncheck staticcheck golangci-lint; do
    [[ -x "$safe_gobin/$tool" ]] || {
      printf 'Go cleanup removed an installed tool (%s): %s\n' "$safe_bin" "$tool" >&2
      exit 1
    }
  done
done
printf 'environment harness passed\n'
